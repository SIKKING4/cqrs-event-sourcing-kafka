{
  "info": {
    "name": "CQRS & Event Sourcing - Bank Account",
    "description": "Prueba de todos los endpoints de account.cmd (puerto 5000) y account.query (puerto 5001).\n\nEjecutar en el orden numerado: las consultas se hacen antes de cerrar la cuenta, porque al cerrarla se elimina de la base de lectura.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "cmdUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "queryUrl", "value": "http://localhost:5001/api/v1" },
    { "key": "accountId", "value": "" },
    { "key": "accountId2", "value": "" }
  ],
  "item": [
    {
      "name": "1. OpenAccountController",
      "item": [
        {
          "name": "1.1 POST Abrir cuenta (Juan Perez)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accountId', body.id);",
                  "console.log('accountId guardado: ' + body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolder\": \"Juan Perez\",\n  \"accountType\": \"SAVINGS\",\n  \"openingBalance\": 1000.00\n}"
            },
            "url": "{{cmdUrl}}/openBankAccount"
          }
        },
        {
          "name": "1.2 POST Abrir segunda cuenta (Maria Lopez)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accountId2', body.id);",
                  "console.log('accountId2 guardado: ' + body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolder\": \"Maria Lopez\",\n  \"accountType\": \"CURRENT\",\n  \"openingBalance\": 5000.00\n}"
            },
            "url": "{{cmdUrl}}/openBankAccount"
          }
        }
      ]
    },
    {
      "name": "2. DepositFundsController",
      "item": [
        {
          "name": "2.1 PUT Depositar fondos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 500.00\n}" },
            "url": "{{cmdUrl}}/depositFunds/{{accountId}}"
          }
        }
      ]
    },
    {
      "name": "3. WithdrawFundsController",
      "item": [
        {
          "name": "3.1 PUT Retirar fondos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 200.00\n}" },
            "url": "{{cmdUrl}}/withdrawFunds/{{accountId}}"
          }
        }
      ]
    },
    {
      "name": "5. AccountLookupController (antes de cerrar)",
      "item": [
        {
          "name": "5a. GET Todas las cuentas",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/" }
        },
        {
          "name": "5b. GET Cuenta por ID",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/byId/{{accountId}}" }
        },
        {
          "name": "5c. GET Cuenta por titular",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/byHolder/Juan Perez" }
        },
        {
          "name": "5d. GET Cuentas con balance mayor a 1000",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/withBalance/GREATER_THAN/1000" }
        },
        {
          "name": "5d. GET Cuentas con balance menor a 2000",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/withBalance/LESS_THAN/2000" }
        }
      ]
    },
    {
      "name": "4. CloseAccountController",
      "item": [
        {
          "name": "4.1 DELETE Cerrar cuenta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": { "method": "DELETE", "header": [], "url": "{{cmdUrl}}/closeBankAccount/{{accountId}}" }
        },
        {
          "name": "4.2 GET Verificar cuenta cerrada (debe dar 204)",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/byId/{{accountId}}" }
        }
      ]
    },
    {
      "name": "6. RestoreReadDbController",
      "item": [
        {
          "name": "6.1 POST Restaurar base de lectura",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": { "method": "POST", "header": [], "url": "{{cmdUrl}}/restoreReadDb" }
        },
        {
          "name": "6.2 GET Verificar cuentas tras restaurar",
          "request": { "method": "GET", "header": [], "url": "{{queryUrl}}/bankAccountLookup/" }
        }
      ]
    }
  ]
}
